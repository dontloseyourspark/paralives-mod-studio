   =GUID:7910482886722659128
   =Key:Item_ShopOdditiesIncenseBurner
   =Value:Oditi
   =InfoForTranslators:Do not translate (except chinese localization)
   =LocalizationState:9
  i8038
   =GUID:1403167757253482074
   =Key:Item_TownTreasureHuntTrunk
   =Value:Treasure Chest
   =InfoForTranslators:A chest that you can find during the public treasure hunt at the castle every thursday.
   =LocalizationState:9
  i8039
   =GUID:1509298538699697794
   =Key:UIGoals_RewardTitle
   =Value:Reward
   =LocalizationState:13
  i8040
   =GUID:3184806910864606649
   =Key:Article_Event_TreasureHuntThursdayFirst
   =Value:The Town Is Holding The Weekly Treasure Hunt! Keep Your Eyes Peeled Around the Castle Plaza
   =InfoForTranslators
   =LocalizationState:13
  i8041
   =GUID:9184939215885652740
   =Key:Article_Event_TreasureHuntThursday
   =Value:The Town Is Holding The Weekly Treasure Hunt Today at the Castle Plaza
   =InfoForTranslators
   =LocalizationState:13
  i8042
   =GUID:673388910807829943
   =Key:UIGoals_ObjectiveIsMultipleItems
   =Value:Have in inventory: {1} x{0}
   =InfoForTranslators:{0} is the number of items, {1} is the name of the item
   =LocalizationState:9
  i8043
   =GUID:3862962684268242269
   =Key:GoalObjective_PurchaseSolarPanelFromGeneralStore
   =Value:Purchase a solar panel from the General Store
   =InfoForTranslators:"General Store" is a shop in the town and should be translated
   =LocalizationState:9
  i8044
   =GUID:7037059197042224017
   =Key:InteractionGroup_GROUP_TrashBagOrBin
   =Value:Trash
   =InfoForTranslators:Items that look like trash can or trash bins. Players can click them to do interactions like "kick angrily" or "find lost item in the trash"
   =LocalizationState:9
  i8045
   =GUID:2338497919833172793
   =Key:GoalObjective_SearchThroughTrash
   =Value:Find the lost item in the Townies' trash on garbage day (Monday)
   =InfoForTranslators:This quests asks the player to search people's trash on the side of the road
   =LocalizationState:13
  i8046
   =GUID:8824252609285324219
   =Key:Notification_Request_OneMansTrash_Failed
   =Value:The lost item wasn't there...
   =InfoForTranslators:Shown when you search trash to find a lost item but the item wasn't in the inspected trash bag or bin
   =LocalizationState:9
  i8047
   =GUID:742828828645664826
   =Key:Interaction_WalkLeisurely
   =Value:Take a walk
   =InfoForTranslators:Interaction that characters can do to slowly walk around a park and look at and enjoy the landscape
   =LocalizationState:9
  i8048
   =GUID:842577406082747227
   =Key:Article_Event_JoggingSaturday
   =Value:The Jogging Club Is Meeting Today for a Run Up the Mountain
   =InfoForTranslators
   =LocalizationState:13
  i8049
   =GUID:2594662130874030644
   =Key:Help_LiveMode_Town2
   =Value:At any time while playing, press M or use the mouse wheel to zoom out and display the town map. Click on a lot's icon to see info about it. To visit the lot, zoom back in and click on it to make your Parafolks go there.
   =InfoForTranslators
   =LocalizationState:13
  i8050
   =GUID:925761178176534389
